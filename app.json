{
  "expo": {
    "name": "DINARY",
    "slug": "dinary",
    "scheme": "dinary",
    "version": "0.1.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4030deb1-49b3-4d9e-a9d5-6ccc97c8a4fa",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbfaf7",
    "ios": {
      "bundleIdentifier": "app.dinary",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "방문 인증 사진을 찍는 데에만 카메라를 씁니다.",
        "NSLocationWhenInUseUsageDescription": "사진을 찍은 식당에서 방문을 인증하고, 지도와 「지금 뭐 먹지」에서 내 주변 가게를 찾기 위해 현재 위치를 사용합니다. 위치 좌표는 저장하지 않습니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "가고 싶은 곳으로 담아 둔 가게 근처(50m)에 가면 알려 드리기 위해 앱을 사용하지 않을 때도 위치를 사용합니다. 위치는 기기 안에서만 확인하며 서버로 보내지 않습니다. 이 알림은 선택 기능이며 설정에서 언제든 끌 수 있습니다.",
        "NSPhotoLibraryUsageDescription": "기록에 붙일 사진과 프로필 사진을 고르고, 갤러리 썸네일을 보여주는 데 씁니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.dinary",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "방문 인증 사진을 찍는 데에만 카메라를 씁니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "가고 싶은 곳으로 담아 둔 가게 근처(50m)에 가면 알려 드리기 위해 앱을 사용하지 않을 때도 위치를 사용합니다. 위치는 기기 안에서만 확인하며 서버로 보내지 않습니다. 이 알림은 선택 기능이며 설정에서 언제든 끌 수 있습니다.",
          "locationAlwaysPermission": "가고 싶은 곳으로 담아 둔 가게 근처(50m)에 가면 알려 드리기 위해 앱을 사용하지 않을 때도 위치를 사용합니다. 위치는 기기 안에서만 확인하며 서버로 보내지 않습니다. 이 알림은 선택 기능이며 설정에서 언제든 끌 수 있습니다.",
          "locationWhenInUsePermission": "사진을 찍은 식당에서 방문을 인증하고, 지도와 「지금 뭐 먹지」에서 내 주변 가게를 찾기 위해 현재 위치를 사용합니다. 위치 좌표는 저장하지 않습니다.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b4552d",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "갤러리 썸네일을 보여주는 데에만 씁니다.",
          "savePhotosPermission": "인증 사진을 사진 앱에 저장합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 붙일 사진과 프로필 사진을 고르는 데 씁니다."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ],
          "iosAppGroupIdentifier": "group.app.dinary"
        }
      ],
      "./plugins/withShareExtensionDisplayName",
      "./plugins/withNaverMaven",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./targets/widget/fonts/GowunBatang-Regular.ttf",
            "./targets/widget/fonts/GowunBatang-Bold.ttf",
            "./targets/widget/fonts/JetBrainsMono-Regular.ttf"
          ],
          "widgets": [
            {
              "name": "CaptureWidget",
              "label": "바로 촬영",
              "description": "누르면 카메라가 바로 열려 방문을 기록합니다.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "MonthWidget",
              "label": "이번 달 인증",
              "description": "이번 달에 인증한 식사 수와 마지막 한 곳.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "MonthDotsWidget",
              "label": "이번 달 인증 · 달력",
              "description": "이번 달 인증한 날을 달력 점으로.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "MonthPhotoWidget",
              "label": "이번 달 인증 · 사진",
              "description": "마지막으로 인증한 식사 사진과 이번 달 인증 수.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4030deb1-49b3-4d9e-a9d5-6ccc97c8a4fa"
      }
    },
    "owner": "dinary-project"
  }
}
